<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme no modo noturno. Mantém texto a preto para máxima legibilidade -->
    <style name="Base.Theme.UrbanAudit" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">#E1F5FE</item>
        <item name="colorOnPrimaryContainer">#01579B</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorError">@color/red_error</item>

        <!-- Contraste de Texto e Caixas de Texto (garante texto sempre preto legível) -->
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:editTextColor">@color/black</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
    </style>
</resources>