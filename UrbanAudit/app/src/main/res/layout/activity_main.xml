<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <!-- Botão Obrigatório para a Secção "Sobre" -->
    <Button
        android:id="@+id/btnSobre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:text="Créditos / Sobre" />
    <TextView
        android:id="@+id/tvTituloApp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignBottom="@id/btnSobre"
        android:gravity="center_vertical"
        android:text="Ocorrências"
        android:textSize="24sp"
        android:textStyle="bold" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOcorrencias"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/btnSobre"
        android:layout_marginTop="16dp" />
    <!-- Botão Flutuante (ou normal) para adicionar ocorrência -->
    <Button
        android:id="@+id/btnNovaOcorrencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:text="Reportar Nova Ocorrência" />
</RelativeLayout>