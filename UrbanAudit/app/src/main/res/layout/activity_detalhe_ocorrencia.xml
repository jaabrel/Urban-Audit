<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:background="@drawable/bg_toolbar_gradient">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetalhe"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Detalhe"
            app:titleTextColor="@color/white"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="12dp">

                <!-- Botão Editar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditarDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/btn_editar"
                    android:textSize="12sp"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/white"
                    app:iconSize="16dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_marginEnd="4dp" />

                <!-- Botão Eliminar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEliminarDetalhe"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="@string/btn_eliminar"
                    android:textSize="12sp"
                    android:textColor="#FFCDD2"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="#FFCDD2"
                    app:iconSize="16dp"
                    style="@style/Widget.MaterialComponents.Button.TextButton" />
            </LinearLayout>

        </com.google.android.material.appbar.MaterialToolbar>

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fotografia em Alta Resolução -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/surface_border"
                app:cardBackgroundColor="#EEEEEE"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivDetalheFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_camera"
                    app:tint="#BDBDBD"
                    android:contentDescription="Fotografia Ampliada" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Cartão Principal de Informação -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/surface_border"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">

                        <TextView
                            android:id="@+id/tvDetalheCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vias e Pavimento"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary"
                            android:background="#E1F5FE"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvDetalheEstado"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pendente"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/status_pendente_text"
                            android:background="@drawable/bg_badge" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDetalheTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Título da Ocorrência"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Descrição"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvDetalheDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descrição detalhada..."
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="16dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="14dp" />

                    <!-- Metadados de Autor e Data -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/text_secondary"
                            android:contentDescription="Autor" />

                        <TextView
                            android:id="@+id/tvDetalheAutor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="estudante@ipt.pt"
                            android:textSize="12sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="6dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvDetalheData"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="05/09/2026 14:30"
                            android:textSize="12sp"
                            android:textColor="@color/text_hint" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Cartão de Localização Geográfica -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/surface_border"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Localização Registada"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_location"
                            app:tint="@color/primary"
                            android:contentDescription="Localização"
                            android:layout_marginTop="2dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:id="@+id/tvDetalheEndereco"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Morada da ocorrência"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary" />

                            <TextView
                                android:id="@+id/tvDetalheCoordenadas"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Lat: 39.6035 | Lng: -8.4078"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAbrirMapa"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Ver Coordenadas no Mapa"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_location"
                        app:iconSize="16dp"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        app:strokeColor="@color/primary"
                        android:textColor="@color/primary"
                        app:cornerRadius="10dp"
                        android:layout_marginTop="14dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
